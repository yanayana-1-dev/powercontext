# ===== SeekMem 配置示例（占位值；按需修改后复制为 .env 或直接 export）=====

# seekdb（服务端模式，MySQL 协议）
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=seekmem

# Embedding：OpenAI 兼容 /v1/embeddings（本地 bge-m3；维度须与 EMBED_DIM 一致且入库前后一致）
EMBED_BASE_URL=http://127.0.0.1:11435/v1
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# LLM：OpenAI 兼容 /v1/chat/completions；不可用自动降级为纯检索模式
# 也可接任意云端 OpenAI 兼容服务（把 BASE_URL/KEY/MODEL 换掉即可）
LLM_ENABLED=1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5-3b-instruct
LLM_API_KEY=local

# PowerContext（记忆与上下文服务）
POWERCONTEXT_BASE_URL=http://127.0.0.1:8010
