# 复制为 .env 后按需修改。全部为占位值，不要提交真实凭据。
# ---- seekdb 连接（MySQL 协议）----
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=test
# ---- Embedding 服务（OpenAI 兼容 /v1/embeddings）----
# 本地 Ollama（默认，零云端依赖）: base_url=http://127.0.0.1:11434/v1  model=bge-m3
# SiliconFlow: base_url=https://api.siliconflow.cn/v1  model=BAAI/bge-m3  api_key=sk-xxxx
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=ollama
EMBEDDING_DIM=1024
# ---- 桥接服务 ----
BRIDGE_LOG_LEVEL=INFO
# 每条检索 SQL 的执行记录落盘路径（评审取证用，可留空关闭）
SQL_TRACE_PATH=/tmp/chronicle_sql_trace.jsonl
